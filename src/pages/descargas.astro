---
// src/pages/descargas.astro
export const prerender = false;

// Reemplaza estos enlaces por las URL públicas directas que obtuviste en MediaFire
const downloadLinux = "https://www.mediafire.com/file/dg16aptin2ceymv/Defensa-Linux.zip/file";
const downloadWindows = "https://www.mediafire.com/file/4naucxj6j54dy0g/Defensa-Windows.zip/file";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yakangustc S.A.S - Descargas</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Lobster&display=swap');

    :root {
      --bg: #0f172a;
      --card-bg: #1e293b;
      --text: #f8fafc;
      --accent: #38bdf8;
      --muted: #94a3b8;
      --border: #334155;
      --hover-green: #22c55e;
      --code-bg: #090d16;
    }

    body { 
      font-family: system-ui, -apple-system, sans-serif; 
      background-color: var(--bg); 
      color: var(--text); 
      margin: 0; 
      padding: 2rem 1rem; 
    }

    .container { max-width: 800px; margin: 0 auto; }
    header { margin-bottom: 2.5rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem; }
    .header-top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; }
    
    .gothic-title {
      font-family: 'Lobster', cursive, sans-serif;
      color: var(--accent);
      margin: 0;
      font-size: 3rem;
      font-weight: 400;
      letter-spacing: 0.02em;
      line-height: 1.1;
    }

    .logo-img { width: 240px; height: auto; object-fit: contain; border-radius: 8px; display: block; }
    
    .nav-menu { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; align-items: center; }
    .nav-btn { 
      background-color: var(--border); 
      color: var(--text); 
      text-decoration: none; 
      padding: 0.5rem 1rem; 
      border-radius: 6px; 
      font-size: 0.875rem; 
      font-weight: 500; 
      border: 1px solid #475569; 
      transition: all 0.2s ease-in-out; 
      cursor: pointer; 
    }
    .nav-btn:hover, .nav-btn.active { 
      background-color: var(--hover-green); 
      color: var(--bg); 
      border-color: var(--hover-green); 
    }

    .grid { display: grid; gap: 1.5rem; }
    .card { 
      background: var(--card-bg); 
      border: 1px solid var(--border); 
      border-radius: 8px; 
      padding: 1.5rem; 
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); 
    }
    .tag { font-size: 0.75rem; font-weight: 600; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em; }

    .card h2 { margin: 0.5rem 0 1rem 0; font-size: 1.5rem; }
    .card p { color: var(--muted); line-height: 1.5; margin-bottom: 1.5rem; }

    /* Estilos de botones de descarga */
    .download-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .btn-download {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      padding: 0.85rem 1.25rem;
      border-radius: 8px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease-in-out;
      border: 1px solid var(--border);
    }

    .btn-windows {
      background-color: #0078d4;
      color: #ffffff;
      border-color: #005a9e;
    }
    .btn-windows:hover {
      background-color: #106ebe;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(0, 120, 212, 0.4);
    }

    .btn-linux {
      background-color: #e95420;
      color: #ffffff;
      border-color: #c74316;
    }
    .btn-linux:hover {
      background-color: #ff6a34;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(233, 84, 32, 0.4);
    }

    /* Caja de instrucciones de consola */
    .terminal-box {
      background-color: var(--code-bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1rem;
      margin-top: 1rem;
    }

    .terminal-box h3 {
      margin: 0 0 0.75rem 0;
      font-size: 0.9rem;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .terminal-box ol {
      margin: 0;
      padding-left: 1.2rem;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .terminal-box li {
      margin-bottom: 0.75rem;
    }

    code {
      display: block;
      background: #1e293b;
      color: #38bdf8;
      padding: 0.5rem 0.75rem;
      border-radius: 4px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.85rem;
      margin-top: 0.3rem;
      border: 1px solid #334155;
    }

    html { scroll-behavior: smooth; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="header-top">
        <h1 class="gothic-title">Yakangustc S.A.S</h1>
        <img src="/logo.png" alt="Logotipo Yakangust" class="logo-img">
      </div>
      <nav class="nav-menu">
        <a href="/" class="nav-btn">Inicio</a>
        <a href="/" class="nav-btn">Identidad</a>
        <a href="/" class="nav-btn">Formacion</a>
        <a href="/descargas" class="nav-btn active">Descargas</a>
        <a href="https://astro-blog-starter-template.yakangust.workers.dev/contacto" class="nav-btn">Asesoría Gratuita</a>
      </nav>
    </header>

    <main class="grid">
      <article class="card">
        <span class="tag">Software de Escritorio</span>
        <h2>Defensa Legal - Visor Multiplataforma</h2>
        <p>
          Aplicación multiplataforma diseñada para la previsualización y grabación continua de cámaras web físicas y virtuales (Iriun Webcam) en entornos Windows y Linux.
        </p>

        <!-- Botones de Descarga -->
        <div class="download-grid">
          <a href={downloadWindows} target="_blank" rel="noopener noreferrer" class="btn-download btn-windows">
             Descargar para Windows (.zip)
          </a>
          <a href={downloadLinux} target="_blank" rel="noopener noreferrer" class="btn-download btn-linux">
             Descargar para Linux (.zip)
          </a>
        </div>

        <!-- Instrucciones para Linux -->
        <div class="terminal-box">
          <h3> Guía de Instalación y Ejecución en Linux (Parrot / Ubuntu / Debian)</h3>
          <ol>
            <li>
              Abre tu terminal, navega a la carpeta de Descargas y descomprime el archivo:
              <code>unzip Defensa-Linux.zip</code>
            </li>
            <li>
              Asigna permisos de ejecución al binario compilado:
              <code>chmod +x Defensa</code>
            </li>
            <li>
              Inicia la aplicación directamente:
              <code>./Defensa</code>
            </li>
          </ol>
        </div>
      </article>
    </main>
  </div>
</body>
</html>
