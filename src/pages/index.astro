---
// src/pages/index.astro

let messageSent = false;
let nombreUsuario = "";
let mensajeError = "";

// Manejo del envío del formulario (POST)
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const payload = {
      nombre: formData.get("nombre")?.toString() || "",
      email: formData.get("email")?.toString() || "",
      telefono: formData.get("telefono")?.toString() || "",
      asunto: formData.get("asunto")?.toString() || "",
      mensaje: formData.get("mensaje")?.toString() || ""
    };

    nombreUsuario = payload.nombre;

    // Obtener variables de entorno en Astro para Cloudflare
    const env = Astro.locals.runtime?.env || process.env;
    const apiKey = env?.RESEND_API_KEY;
    const toEmail = env?.DESTINATION_EMAIL;

    if (apiKey && toEmail) {
      const res = await fetch("https://api.resend.com/emails", {
        method: "POST",
        headers: {
          "Authorization": `Bearer ${apiKey}`,
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          from: "Yakangustc <onboarding@resend.dev>",
          to: [toEmail],
          subject: `Nueva solicitud: ${payload.asunto} - ${payload.nombre}`,
          html: `
            <h2>Nueva Solicitud de Asesoría Gratuita</h2>
            <p><strong>Nombre:</strong> ${payload.nombre}</p>
            <p><strong>Correo electrónico:</strong> ${payload.email}</p>
            <p><strong>Teléfono:</strong> ${payload.telefono}</p>
            <p><strong>Asunto:</strong> ${payload.asunto}</p>
            <p><strong>Mensaje / Detalles:</strong></p>
            <blockquote style="background: #f1f5f9; padding: 10px; border-left: 4px solid #38bdf8; color: #0f172a;">
              ${payload.mensaje}
            </blockquote>
          `
        })
      });

      if (res.ok) {
        messageSent = true;
      } else {
        mensajeError = "No se pudo enviar el correo. Por favor intenta más tarde.";
      }
    } else {
      mensajeError = "Faltan las variables de entorno RESEND_API_KEY o DESTINATION_EMAIL.";
    }
  } catch (e) {
    console.error("Error al procesar formulario:", e);
    mensajeError = "Ocurrió un error al procesar la solicitud.";
  }
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yakangustc S.A.S - Inicio</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Lobster&display=swap');

    :root {
      --bg: #0f172a;
      --card-bg: #1e293b;
      --text: #f8fafc;
      --accent: #38bdf8;
      --muted: #94a3b8;
      --input-bg: #0f172a;
      --border: #334155;
      --hover-green: #22c55e;
    }
    body { font-family: system-ui, -apple-system, sans-serif; background-color: var(--bg); color: var(--text); margin: 0; padding: 2rem 1rem; }
    .container { max-width: 800px; margin: 0 auto; }
    header { margin-bottom: 2.5rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem; }
    .header-top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; }
    
    .gothic-title {
      font-family: 'Lobster', cursive, sans-serif;
      color: var(--accent);
      margin: 0;
      font-size: 3rem;
      font-weight: 400;
      letter-spacing: 0.02em;
      line-height: 1.1;
    }

    .logo-img { width: 240px; height: auto; object-fit: contain; border-radius: 8px; display: block; }
    .nav-menu { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
    .nav-btn { background-color: var(--border); color: var(--text); text-decoration: none; padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.875rem; font-weight: 500; border: 1px solid #475569; transition: all 0.2s ease-in-out; cursor: pointer; }
    .nav-btn:hover { background-color: var(--hover-green); color: var(--bg); border-color: var(--hover-green); }
    .grid { display: grid; gap: 1.5rem; }
    .card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
    .tag { font-size: 0.75rem; font-weight: 600; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em; }
    
    .card-header-title { display: flex; align-items: center; gap: 0.75rem; margin: 0.5rem 0 1rem 0; flex-wrap: wrap; }
    .card-header-title h2 { margin: 0; font-size: 1.25rem; text-transform: capitalize; }
    
    .title-link { display: inline-flex; align-items: center; justify-content: center; padding: 4px; border-radius: 50%; border: 2px solid transparent; transition: all 0.25s ease-in-out; text-decoration: none; }
    .title-link-icon { width: 28px; height: 28px; object-fit: contain; display: block; border-radius: 50%; }
    .title-link:hover {
      border-color: var(--hover-green);
      box-shadow: 0 0 12px var(--hover-green);
      transform: translateY(-2px);
    }

    .card p { color: var(--muted); line-height: 1.5; margin: 0; }
    .card-video { width: 100%; max-height: 420px; border-radius: 8px; background-color: #000; margin-top: 0.5rem; outline: none; border: 1px solid var(--border); }
    
    .social-container { display: flex; gap: 1.25rem; align-items: center; margin-top: 1rem; }
    .social-link { display: inline-block; border-radius: 50%; padding: 4px; transition: all 0.25s ease-in-out; border: 2px solid transparent; }
    .social-icon { width: 48px; height: 48px; object-fit: contain; display: block; border-radius: 50%; }
    .social-link:hover {
      border-color: var(--hover-green);
      box-shadow: 0 0 12px var(--hover-green);
      transform: translateY(-2px);
    }

    .form-group { margin-bottom: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
    label { font-size: 0.875rem; font-weight: 600; color: var(--text); }
    input, select, textarea { width: 100%; padding: 0.75rem; background-color: var(--input-bg); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-family: inherit; box-sizing: border-box; }
    input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); }
    .btn-submit { background-color: var(--accent); color: var(--bg); font-weight: 600; padding: 0.75rem 1.5rem; border: none; border-radius: 6px; cursor: pointer; transition: background 0.2s; }
    .btn-submit:hover { background-color: var(--hover-green); }
    .alert-error { background: #7f1d1d; border: 1px solid #ef4444; color: #f8fafc; padding: 1rem; border-radius: 6px; margin-bottom: 1.5rem; }

    /* Desplazamiento fluido al presionar las anclas */
    html {
      scroll-behavior: smooth;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="header-top">
        <h1 class="gothic-title">Yakangustc S.A.S</h1>
        <img src="/logo.png" alt="Logotipo Yakangust" class="logo-img">
      </div>
      <nav class="nav-menu">
        <a href="/" class="nav-btn">Inicio</a>
        <a href="#formatos" class="nav-btn">Archivos</a>
        <a href="#escritos" class="nav-btn">Escritos</a>
        <a href="#leyes" class="nav-btn">Leyes</a>
        <a href="#contacto" class="nav-btn">Asesoría Gratuita</a>
      </nav>
    </header>

    <main class="grid">
      <!-- Tarjetas de Video -->
      <article class="card">
        <span class="tag">Plan de negocios</span>
        <div class="card-header-title">
          <h2>Asesoría gratuita para la creación de tu plan de negocios</h2>
          <a href="#contacto" class="title-link" title="Solicitar Asesoría"><img src="/enlace.svg" alt="Enlace Asesoría" class="title-link-icon"></a>
        </div>
        <video class="card-video" controls preload="metadata">
          <source src="/plan.mp4" type="video/mp4">
          Tu navegador no soporta la reproducción de video HTML5.
        </video>
      </article>

      <article class="card">
        <span class="tag">Apertura tu empresa gratis</span>
        <div class="card-header-title">
          <h2>Asesoría gratuita para la apertura de tu propia empresa</h2>
          <a href="#contacto" class="title-link" title="Solicitar Asesoría"><img src="/enlace.svg" alt="Enlace Asesoría" class="title-link-icon"></a>
        </div>
        <video class="card-video" controls preload="metadata">
          <source src="/empresa.mp4" type="video/mp4">
          Tu navegador no soporta la reproducción de video HTML5.
        </video>
      </article>

      <article class="card">
        <span class="tag">Cumple con tus obligaciones Fiscales</span>
        <div class="card-header-title">
          <h2>Asesoría gratuita para dar cumplimiento con tus obligaciones Fiscales</h2>
          <a href="#contacto" class="title-link" title="Solicitar Asesoría"><img src="/enlace.svg" alt="Enlace Asesoría" class="title-link-icon"></a>
        </div>
        <video class="card-video" controls preload="metadata">
          <source src="/obligaciones.mp4" type="video/mp4">
          Tu navegador no soporta la reproducción de video HTML5.
        </video>
      </article>

      <article class="card">
        <span class="tag">Crea tu manual de procedimientos</span>
        <div class="card-header-title">
          <h2>Asesoria Gratuita para la Creación de Manuales de procedimientos</h2>
          <a href="#contacto" class="title-link" title="Solicitar Asesoría"><img src="/enlace.svg" alt="Enlace Asesoría" class="title-link-icon"></a>
        </div>
        <video class="card-video" controls preload="metadata">
          <source src="/manuales.mp4" type="video/mp4">
          Tu navegador no soporta la reproducción de video HTML5.
        </video>

      <!-- Formulario de Asesoría Gratuita integrando Resend -->
      <section id="contacto" class="card">
        <span class="tag">Asesoría Gratuita</span>
        <h2>Solicitud de Asesoría Gratuita</h2>
        <p style="margin-bottom: 1.5rem;">Completa el formulario para evaluar tu proyecto o consulta sin ningún costo.</p>

        {messageSent && (
          <div class="alert-success">
            ¡Gracias, {nombreUsuario}! Hemos recibido tu solicitud. Nos pondremos en contacto a la brevedad.
          </div>
        )}

        {mensajeError && (
          <div class="alert-error">
            {mensajeError}
          </div>
        )}

        <form method="POST" action="#contacto">
          <div class="form-group">
            <label for="nombre">Nombre completo</label>
            <input type="text" id="nombre" name="nombre" required placeholder="Ej. Juan Pérez">
          </div>

          <div class="form-group">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" required placeholder="correo@ejemplo.com">
          </div>

          <div class="form-group">
            <label for="telefono">Teléfono / WhatsApp</label>
            <input type="tel" id="telefono" name="telefono" required placeholder="55 1234 5678">
          </div>

          <div class="form-group">
            <label for="asunto">Tipo de trámite o asunto</label>
            <select id="asunto" name="asunto" required>
              <option value="">Selecciona una opción</option>
              <option value="Plan de Negocios">Plan de Negocios</option>
              <option value="Apertura de Empresa">Apertura de Empresa (S.A.S)</option>
              <option value="Obligaciones Fiscales">Obligaciones Fiscales</option>
              <option value="Manuales de Procedimientos">Manuales de Procedimientos</option>
              <option value="Otro">Otro asunto</option>
            </select>
          </div>

          <div class="form-group">
            <label for="mensaje">Detalles del caso</label>
            <textarea id="mensaje" name="mensaje" rows="5" required placeholder="Describe brevemente la situación o proyecto..."></textarea>
          </div>

          <button type="submit" class="btn-submit">Enviar Solicitud</button>
        </form>
      </section>

      <!-- Redes Sociales -->
      <article class="card">
        <span class="tag">Redes Sociales</span>
        <div class="card-header-title">
          <h2>Ponte en contacto con nosotros</h2>
        </div>
        <div class="social-container">
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="social-link" title="Facebook">
            <img src="/facebook.png" alt="Facebook" class="social-icon">
          </a>
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-link" title="Instagram">
            <img src="/instagram.png" alt="Instagram" class="social-icon">
          </a>
          <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" class="social-link" title="TikTok">
            <img src="/tiktok.svg" alt="TikTok" class="social-icon">
          </a>
        </div>
      </article>
    </main>
  </div>
</body>
</html>
