---
// src/pages/index.astro
async function fetchSampleData() {
  return [
    { id: 1, title: "Formato de Demanda Inicial", body: "Plantilla editable para redactar una demanda inicial." },
    { id: 2, title: "Escrito de Promoción General", body: "Modelo para presentar promociones de mero trámite." },
    { id: 3, title: "Compendio de Leyes y Códigos", body: "Acceso directo a la normatividad vigente." },
    { id: 4, title: "Videotutoriales de Procedimiento", body: "Guías en video sobre trámites en plataformas oficiales." },
    { id: 5, title: "Repositorio de Archivos y Anexos", body: "Documentos de apoyo y archivos multimedia." },
  ];
}

let messageSent = false;
let nombreUsuario = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const payload = {
      nombre: formData.get("nombre") || "",
      email: formData.get("email") || "",
      telefono: formData.get("telefono") || "",
      asunto: formData.get("asunto") || "",
      mensaje: formData.get("mensaje") || ""
    };

    nombreUsuario = payload.nombre.toString();

    const env = Astro.locals.runtime?.env || process.env;
    const apiKey = env?.RESEND_API_KEY;
    const toEmail = env?.DESTINATION_EMAIL;

    if (apiKey && toEmail) {
      await fetch("https://api.resend.com/emails", {
        method: "POST",
        headers: {
          "Authorization": `Bearer ${apiKey}`,
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          from: "Defensa Legal <onboarding@resend.dev>",
          to: [toEmail],
          subject: `Nueva solicitud: ${payload.asunto} - ${payload.nombre}`,
          html: `
            <h2>Nueva Solicitud de Asesoría Gratuita</h2>
            <p><strong>Nombre:</strong> ${payload.nombre}</p>
            <p><strong>Correo electrónico:</strong> ${payload.email}</p>
            <p><strong>Teléfono:</strong> ${payload.telefono}</p>
            <p><strong>Asunto:</strong> ${payload.asunto}</p>
            <p><strong>Mensaje / Detalles:</strong></p>
            <blockquote style="background: #f1f5f9; padding: 10px; border-left: 4px solid #38bdf8; color: #0f172a;">
              ${payload.mensaje}
            </blockquote>
          `
        })
      });
    }
    messageSent = true;
  } catch (e) {
    console.error("Error al procesar formulario:", e);
  }
}

const commonStyles = `
  @import url('https://fonts.googleapis.com/css2?family=Lobster&display=swap');

  :root {
    --bg: #0f172a;
    --card-bg: #1e293b;
    --text: #f8fafc;
    --accent: #38bdf8;
    --muted: #94a3b8;
    --input-bg: #0f172a;
    --border: #334155;
    --hover-green: #22c55e;
  }
  body {
    font-family: system-ui, -apple-system, sans-serif;
    background-color: var(--bg);
    color: var(--text);
    margin: 0;
    padding: 20px;
  }
  .container {
    max-width: 900px;
    margin: 0 auto;
  }
  header {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
  }
  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .brand-title {
    font-family: 'Lobster', cursive;
    color: var(--accent);
    font-size: 2.2rem;
    margin: 0;
  }
  nav {
    display: flex;
    gap: 15px;
    align-items: center;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  nav a:hover {
    color: var(--accent);
  }
  .social-bar {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--card-bg);
    border: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .social-icon:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }
  .social-icon svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  .btn-contacto {
    background-color: var(--accent);
    color: var(--bg) !important;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: bold;
    transition: background-color 0.2s;
  }
  .btn-contacto:hover {
    background-color: var(--hover-green);
    color: #ffffff !important;
  }
  .main-content {
    background-color: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.4);
  }
`;
---

