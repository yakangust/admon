---
// src/pages/formacion.astro
export const prerender = false;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yakangustc S.A.S - Formación Académica</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Lobster&display=swap');

    :root {
      --bg: #0f172a;
      --card-bg: #1e293b;
      --text: #f8fafc;
      --accent: #38bdf8;
      --muted: #94a3b8;
      --input-bg: #0f172a;
      --border: #334155;
      --hover-green: #22c55e;
    }
    body { font-family: system-ui, -apple-system, sans-serif; background-color: var(--bg); color: var(--text); margin: 0; padding: 2rem 1rem; }
    .container { max-width: 800px; margin: 0 auto; }
    header { margin-bottom: 2.5rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem; }
    .header-top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; }
    
    .gothic-title {
      font-family: 'Lobster', cursive, sans-serif;
      color: var(--accent);
      margin: 0;
      font-size: 3rem;
      font-weight: 400;
      letter-spacing: 0.02em;
      line-height: 1.1;
    }

    .logo-img { width: 240px; height: auto; object-fit: contain; border-radius: 8px; display: block; }
    .nav-menu { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; align-items: center; }
    .nav-btn { background-color: var(--border); color: var(--text); text-decoration: none; padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.875rem; font-weight: 500; border: 1px solid #475569; transition: all 0.2s ease-in-out; cursor: pointer; }
    .nav-btn:hover, .nav-btn.active { background-color: var(--hover-green); color: var(--bg); border-color: var(--hover-green); }
    .grid { display: grid; gap: 1.5rem; }
    .card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
    .tag { font-size: 0.75rem; font-weight: 600; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em; }
    
    .profile-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.5rem;
      margin-bottom: 1rem;
    }

    @media (min-width: 600px) {
      .profile-header {
        flex-direction: row;
        text-align: left;
      }
    }

    .profile-img {
      width: 160px;
      height: 160px;
      object-fit: cover;
      border-radius: 50%;
      border: 3px solid var(--accent);
      box-shadow: 0 0 15px rgba(56, 189, 248, 0.2);
    }

    .profile-info h2 {
      margin: 0 0 0.5rem 0;
      font-size: 1.75rem;
      color: var(--text);
    }

    .profile-info p {
      color: var(--accent);
      font-weight: 500;
      margin: 0;
    }

    .timeline {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      margin-top: 1rem;
    }

    .timeline-item {
      border-left: 3px solid var(--accent);
      padding-left: 1rem;
    }

    .timeline-item h3 {
      margin: 0 0 0.25rem 0;
      font-size: 1.1rem;
      color: var(--text);
    }

    .timeline-item .institution {
      font-size: 0.875rem;
      color: var(--hover-green);
      font-weight: 600;
      margin-bottom: 0.5rem;
      display: block;
    }

    .timeline-item p {
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.5;
      margin: 0;
    }

    .social-container { display: flex; gap: 1rem; align-items: center; margin-top: 1rem; }
    .title-link { display: inline-flex; align-items: center; justify-content: center; padding: 4px; border-radius: 50%; border: 2px solid transparent; transition: all 0.25s ease-in-out; text-decoration: none; }
    .title-link-icon { width: 32px; height: 32px; object-fit: contain; display: block; border-radius: 50%; }
    .title-link:hover {
      border-color: var(--hover-green);
      box-shadow: 0 0 12px var(--hover-green);
      transform: translateY(-2px);
    }

    html {
      scroll-behavior: smooth;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="header-top">
        <h1 class="gothic-title">Yakangustc S.A.S</h1>
        <img src="/logo.png" alt="Logotipo Yakangust" class="logo-img">
      </div>
      <nav class="nav-menu">
        <a href="/" class="nav-btn">Inicio</a>
        <a href="/tramites" class="nav-btn">Tramites</a>
        <a href="/formacion" class="nav-btn active">Formacion</a>
        <a href="/descargas" class="nav-btn">Descargas</a>
        <a href="https://astro-blog-starter-template.yakangust.workers.dev/contacto" class="nav-btn">Asesoría Gratuita</a>
      </nav>
    </header>

    <main class="grid">
      <!-- Tarjeta de Perfil Profesional -->
      <article class="card">
        <span class="tag">Perfil Profesional</span>
        <div class="profile-header" style="margin-top: 1rem;">
          <img src="/perfil.jpg" alt="Arturo Galeno Hernández" class="profile-img">
          <div class="profile-info">
            <h2>Arturo Galeno Hernández</h2>
            <p>Especialista en Administración y Contribuciones Fiscales</p>
          </div>
        </div>
      </article>

      <!-- Tarjeta de Trayectoria Académica -->
      <article class="card">
        <span class="tag">Trayectoria Académica</span>
        <h2 style="margin: 0.5rem 0 1.25rem 0; font-size: 1.25rem;">Grados y Certificaciones</h2>
        
        <div class="timeline">
          <div class="timeline-item">
            <h3>Maestría en Administración de las Contribuciones</h3>
            <span class="institution">Universidad Nacional Autónoma de México (UNAM)</span>
            <p>Especialización de posgrado enfocada en el análisis, gestión y cumplimiento estratégico de las obligaciones fiscales e impuestos.</p>
          </div>

          <div class="timeline-item">
            <h3>Diplomado en Administración Estratégica de Recursos Humanos</h3>
            <span class="institution">Universidad Nacional Autónoma de México (UNAM)</span>
            <p>Formación especializada en gestión del talento, planeación organizacional y optimización de capital humano.</p>
          </div>

          <div class="timeline-item">
            <h3>Licenciatura en Administración</h3>
            <span class="institution">Universidad Nacional Autónoma de México (UNAM)</span>
            <p>Formación universitaria integral en dirección empresarial, finanzas, procesos administrativos y desarrollo de proyectos.</p>
          </div>
        </div>
      </article>

      <!-- Sección de Redes Sociales -->
      <article class="card">
        <h2>Visita Nuestras Redes Sociales</h2>
        <nav class="social-container">
          <a href="#contacto" class="title-link" title="Facebook">
            <img src="/facebook.png" alt="Facebook" class="title-link-icon">
          </a>
          <a href="#contacto" class="title-link" title="Instagram">
            <img src="/instagram.png" alt="Instagram" class="title-link-icon">
          </a>
          <a href="#contacto" class="title-link" title="TikTok">
            <img src="/tiktok.svg" alt="TikTok" class="title-link-icon">
          </a>
        </nav>
      </article>
    </main>
  </div>
</body>
</html>
